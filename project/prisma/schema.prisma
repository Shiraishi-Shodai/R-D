generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(30)
  email         String    @unique @db.VarChar(319)
  emailVerified DateTime? @db.Timestamp(6)
  password      String?   @db.VarChar(72)
  address       String?   @db.VarChar(20)
  postal_code   String?   @db.VarChar(7)
  role          UserRole  @default(USER)
  image         String?   @db.VarChar
  credit_number String?   @db.VarChar(72)
  accounts      Account[]

  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String  @db.VarChar
  provider          String  @db.VarChar
  providerAccountId String  @map("provider_account_id") @db.VarChar
  refresh_token     String? @db.VarChar
  access_token      String? @db.VarChar
  expires_at        Int?
  token_type        String? @db.VarChar
  scope             String?
  id_token          String?
  session_state     String? @db.VarChar
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model password_reset_token {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email   String   @unique @db.VarChar(319)
  token   String   @unique
  expires DateTime @db.Timestamp(6)

  @@unique([email, token], map: "uni_passwor_reset_email_token")
}

model verification_token {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email   String   @unique @db.VarChar(319)
  token   String   @unique
  expires DateTime @db.Timestamp(6)

  @@unique([email, token], map: "uni_verification_email_token")
}

enum UserRole {
  USER
  ADMIN
}
